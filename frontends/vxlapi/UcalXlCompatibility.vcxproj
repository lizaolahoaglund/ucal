    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals"><UcalRoot Condition="'$(UcalRoot)'==''">$(MSBuildThisFileDirectory)..\..\ucal\</UcalRoot><ProjectGuid>{84359DBB-82D5-4CE3-B7B3-D48093774065}</ProjectGuid><Keyword>Win32Proj</Keyword><RootNamespace>UcalXlFrontend</RootNamespace><ProjectName>UcalXlCompatibility</ProjectName></PropertyGroup>
