  <ItemDefinitionGroup>
    <ClCompile><AdditionalIncludeDirectories>$(UcalRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories><PreprocessorDefinitions>UCAL_XL_STANDALONE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
