<Project>
  <PropertyGroup>
    <!-- Use the installed Visual Studio default toolset. Both properties can be
         pinned by the caller with MSBuild /p:... for a qualification build. -->
    <ForceImportBeforeCppProps Condition="'$(ForceImportBeforeCppProps)'==''">$(MSBuildThisFileDirectory)tools\DefaultCppToolset.props</ForceImportBeforeCppProps>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)'==''">10.0</WindowsTargetPlatformVersion>
    <UcalRepositoryRoot>$(MSBuildThisFileDirectory)</UcalRepositoryRoot>
    <SolutionDir Condition="'$(SolutionDir)'=='' Or '$(SolutionDir)'=='*Undefined*'">$(UcalRepositoryRoot)</SolutionDir>
    <CharacterSet>Unicode</CharacterSet>
    <TreatWarningAsError>true</TreatWarningAsError>
    <OutDir>$(SolutionDir)out\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)out\build\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(UcalRepositoryRoot);$(UcalRepositoryRoot)ucal\include;$(UcalRepositoryRoot)ucal\src;$(UcalRepositoryRoot)ucal\src\host;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ProgramDataBaseFileName>$(IntDir)$(ProjectName).pdb</ProgramDataBaseFileName>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
